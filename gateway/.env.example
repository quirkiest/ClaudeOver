# jibo-gateway config - copy to .env and fill in. .env is gitignored.

ANTHROPIC_API_KEY=sk-ant-...
# openssl rand -hex 24
GATEWAY_TOKEN=

# Published port / LAN bind address on the host
PORT=8765
BIND_ADDR=192.168.20.26

# Only these client IPs may call /v1/* (comma-separated). Jibo + the linux box.
# NOTE: with Docker's default bridge network the source IP is preserved for
# LAN clients, but calls from the host itself arrive as the bridge gateway
# (typically 172.17.0.1 / 172.18.0.1). Check `docker compose logs` for the
# "rejected ip" line and add it if you want to curl from the linux box itself.
ALLOW_IPS=192.168.20.40,192.168.20.26,172.18.0.1

CLAUDE_MODEL=claude-sonnet-5
MAX_TOKENS=300
MAX_TURNS=12
SESSION_TTL_S=300
RATE_PER_MIN=20
CLAUDE_TIMEOUT_MS=20000

TZ=Australia/Melbourne
JIBO_TZ=Australia/Melbourne
JIBO_PLACE=Melbourne, Australia

# 1 = answer "what time/date is it" locally without calling Claude
LOCAL_HANDLERS=1
# 1 = keep session history across container restarts (./data/sessions.json)
PERSIST=0
# 1 = log full question/answer text (off by default)
LOG_TRANSCRIPTS=0

# ── ClaudeOver (takeover) mode ─────────────────────────────────────────────
# 1 = allow POST /v1/takeover to put Jibo into Claude mode via a ROM session
TAKEOVER_ENABLED=1
JIBO_HOST=192.168.20.40
# ms to listen after "Hey Jibo" (both time and noSpeechTime)
JIBO_LISTEN_MS=15000
# auto-off after this many minutes without a wakeword (0 = never)
TAKEOVER_IDLE_MIN=30
# wait before grabbing ROM so the menu skill can exit
TAKEOVER_START_DELAY_MS=2500
# 'text' = show instructions on Jibo's screen while in Claude mode, 'eye' = normal eye
TAKEOVER_SCREEN=text
